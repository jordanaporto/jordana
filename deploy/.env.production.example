# ---------------------------------------------------------------
# Produção (docker compose). Copie para ".env" na raiz do projeto.
# Gere senhas fortes:  openssl rand -base64 24
# ---------------------------------------------------------------
DOMAIN=sistema.injecar.com.br
APP_URL=https://sistema.injecar.com.br

POSTGRES_PASSWORD=
APP_DB_PASSWORD=

STORAGE_DRIVER=local
# Para guardar fotos fora do servidor (recomendado com o tempo):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=injecar-midia
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

CRON_SECRET=
ENABLE_BACKGROUND_WORKER=true

# WhatsApp Business Platform (Cloud API) — preencher quando a Meta aprovar
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Avisos no celular da equipe (Web Push). Gere com: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@injecar.com.br

# ---------------------------------------------------------------
# Marca da oficina (o produto é o "Sistema de Serviço para Oficina")
# Pasta em public/brand/<pasta>/ com logo-sm.png, icon-192.png, icon-512.png, apple-touch-icon.png
# Exige nova publicação ao mudar (são lidas na compilação).
# ---------------------------------------------------------------
NEXT_PUBLIC_OFICINA_NOME=Minha Oficina
NEXT_PUBLIC_OFICINA_NOME_CURTO=
NEXT_PUBLIC_OFICINA_PASTA=
NEXT_PUBLIC_OFICINA_COR=2563eb   # cor principal, sem o # (ex.: c80000)
