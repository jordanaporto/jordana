# ---------------------------------------------------------------
# Banco de dados (PostgreSQL 15+)
# ---------------------------------------------------------------
# Dono do banco: usado SOMENTE para migrações e criação do primeiro admin
DATABASE_ADMIN_URL=postgres://postgres:SENHA_DONO@localhost:5432/injecar
# Usuário da aplicação (criado pelas migrações). Senha com 12+ caracteres.
DATABASE_URL=postgres://injecar_app:TROQUE_ESTA_SENHA@localhost:5432/injecar

# Endereço público do sistema (usado em links e cookies)
APP_URL=http://localhost:3000


# ---------------------------------------------------------------
# Armazenamento de fotos/vídeos/relatórios
# ---------------------------------------------------------------
# "local" (pasta no servidor) ou "s3" (AWS S3, Cloudflare R2, Supabase Storage S3, MinIO...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------
# WhatsApp Business Platform (Cloud API oficial da Meta)
# Deixe em branco enquanto usa o modo manual.
# ---------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Protege os endpoints de tarefas agendadas (fila de mensagens)
CRON_SECRET=
# "true" processa a fila de WhatsApp a cada minuto dentro do próprio servidor
ENABLE_BACKGROUND_WORKER=true

# Avisos no celular da equipe (Web Push). Gere com: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@injecar.com.br
